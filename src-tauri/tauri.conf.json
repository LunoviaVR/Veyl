{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyl",
  "version": "0.1.0",
  "identifier": "app.veyl.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veyl",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Windows PC health, performance and crash diagnostics",
    "longDescription": "Real-time system monitoring, hardware sensors, frame-time analysis, crash and blue-screen investigation, stability history and alerts for Windows.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QzYzN0E5MTA2NEYxREIKUldUYjhXUVFxVGZHU01IbUd2dlRKSHE3R0dJbWNVSzlCYkZRZGNtYk5LakxhSVdZVkdqT2ZJbDUK",
      "endpoints": [
        "https://github.com/LunoviaVR/Veyl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
