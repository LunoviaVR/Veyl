{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: every app command, plus core window/event APIs and setting the title-bar theme. File, shell and network access stay in Rust.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "allow-get-system-info",
    "allow-get-pc-specs",
    "allow-get-latest",
    "allow-set-ui-visible",
    "allow-get-runtime-status",
    "allow-restart-as-admin",
    "allow-get-boot-status",
    "allow-restart-into",
    "allow-cancel-safe-mode",
    "allow-open-app-folder",
    "allow-get-update-status",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-processes",
    "allow-get-process-details",
    "allow-end-process",
    "allow-end-process-tree",
    "allow-set-process-priority",
    "allow-reveal-path",
    "allow-get-services",
    "allow-get-startup-items",
    "allow-get-connections",
    "allow-get-sensors",
    "allow-reset-sensor-stats",
    "allow-get-drive-health",
    "allow-refresh-drive-health",
    "allow-install-pawnio",
    "allow-get-stability-events",
    "allow-get-event-channels",
    "allow-get-event-detail",
    "allow-get-bsod-overview",
    "allow-analyze-dump",
    "allow-install-debugger",
    "allow-get-diagnostics",
    "allow-get-timeline",
    "allow-get-gaming-status",
    "allow-get-game-candidates",
    "allow-start-capture",
    "allow-stop-capture",
    "allow-get-game-sessions",
    "allow-get-game-session",
    "allow-delete-game-session",
    "allow-set-overlay-enabled",
    "allow-set-auto-capture-games",
    "allow-set-overlay-style",
    "allow-set-overlay-position",
    "allow-get-capture-interfaces",
    "allow-start-packet-capture",
    "allow-stop-packet-capture",
    "allow-clear-packets",
    "allow-get-packets",
    "allow-get-packet-detail",
    "allow-check-packet-filter",
    "allow-get-metric-catalog",
    "allow-get-history",
    "allow-get-alert-history",
    "allow-get-active-alerts",
    "allow-clear-active-alerts",
    "allow-get-settings",
    "allow-save-settings",
    "allow-reset-alert-rules",
    "allow-export-history-csv",
    "allow-export-pc-specs",
    "allow-export-session-csv",
    "allow-export-events-csv",
    "allow-export-report"
  ]
}
